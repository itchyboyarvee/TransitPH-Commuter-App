<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView style="@style/TransitEyebrow" android:text="Commuter account" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_dark_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome back." android:textColor="@color/brand_cream" android:textSize="29sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Sign in to search routes and keep your usual rides close." android:textColor="@color/brand_mist" android:textSize="13sp" />
            <EditText android:id="@+id/login_email" style="@style/TransitInput" android:layout_marginTop="18dp" android:hint="Email" android:inputType="textEmailAddress" />
            <EditText android:id="@+id/login_password" style="@style/TransitInput" android:layout_marginTop="10dp" android:hint="Password" android:inputType="textPassword" />
            <Button android:id="@+id/login_submit" style="@style/TransitButton" android:layout_marginTop="12dp" android:text="Sign in  →" />
        </LinearLayout>
        <TextView android:id="@+id/login_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/brand_coral" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>