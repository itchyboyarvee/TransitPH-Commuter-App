<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView style="@style/TransitEyebrow" android:text="Route finder" />
        <TextView style="@style/TransitPageTitle" android:text="A better ride starts with the right route." />
        <EditText android:id="@+id/routes_from" style="@style/TransitInput" android:layout_marginTop="22dp" android:hint="FROM  ·  e.g. Dasmariñas" />
        <EditText android:id="@+id/routes_to" style="@style/TransitInput" android:layout_marginTop="10dp" android:hint="TO  ·  e.g. Nuvali" />
        <Button android:id="@+id/routes_search" style="@style/TransitButton" android:layout_marginTop="12dp" android:text="Find route  →" />
        <TextView android:id="@+id/routes_summary" style="@style/TransitInfoTitle" android:layout_marginTop="24dp" android:text="Search for a ride across CALABARZON." />
        <LinearLayout android:id="@+id/routes_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>