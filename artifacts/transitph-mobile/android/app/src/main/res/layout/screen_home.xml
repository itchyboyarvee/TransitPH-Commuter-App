<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">

        <TextView style="@style/TransitEyebrow" android:text="Morning route brief" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Go places.&#10;Know the way."
            android:textColor="@color/brand_deep"
            android:textSize="42sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="A clearer way to ride across Cavite, Laguna, Batangas, Rizal, and Quezon."
            android:textColor="@color/brand_muted"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <LinearLayout
            android:id="@+id/home_search_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_panel">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Where are you headed?"
                android:textColor="@color/brand_cream"
                android:textSize="16sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/home_from"
                style="@style/TransitInput"
                android:layout_marginTop="12dp"
                android:hint="FROM  ·  e.g. Dasmariñas"
                android:inputType="textCapSentences" />
            <EditText
                android:id="@+id/home_to"
                style="@style/TransitInput"
                android:layout_marginTop="10dp"
                android:hint="TO  ·  e.g. Nuvali"
                android:inputType="textCapSentences" />
            <Button
                android:id="@+id/home_find_route"
                style="@style/TransitButton"
                android:layout_marginTop="12dp"
                android:text="Find route  →" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="Search by barangay, landmark, terminal, or city."
                android:textColor="@color/brand_mist"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView style="@style/TransitSectionTitle" android:text="Nearby terminals" />
            <TextView
                android:id="@+id/home_view_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="View all  ›"
                android:textColor="@color/brand_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/home_terminal_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/home_weather_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_panel">
            <TextView android:id="@+id/home_weather_location" style="@style/TransitEyebrowLight" android:text="CALABARZON" />
            <TextView
                android:id="@+id/home_weather_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="28°"
                android:textColor="@color/brand_cream"
                android:textSize="52sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/home_weather_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Partly cloudy"
                android:textColor="@color/brand_cream"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/home_weather_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Light showers possible · demo weather data"
                android:textColor="@color/brand_mist"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>